# ---------------------------------------------------------------------------
# LeadByte frontend (BFF) configuration
#
# Copy to .env.local and fill in. With LEADBYTE_API_URL unset, the app runs
# entirely on mock repositories — that is a supported, working mode, not a
# broken one. Setting it switches every migrated repository to the live
# leadbyte-api Lambda.
# ---------------------------------------------------------------------------

# Base URL of the leadbyte-api Lambda Function URL, no trailing slash.
# e.g. https://xxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-east-1.on.aws
LEADBYTE_API_URL=

# Gateway key sent as the `x-api-key` header. Required by the newer backend
# (leadbyte-api_v1), which gates every route behind it before routing.
# Leave empty for the older production Lambda, which has no such layer.
# NOT NEXT_PUBLIC_ - this must never reach the browser bundle.
LEADBYTE_API_KEY=

# ---------------------------------------------------------------------------
# AEO agent service — a SECOND backend, separate from leadbyte-api.
#
# A FastAPI Lambda that audits a site for how AI answer engines read it:
# server rendering, robots.txt, sitemap, llms.txt, structured data, meta tags,
# content structure, brand consistency, freshness. Powers the AEO agent and
# nothing else. Unset means that agent says the service is not available; the
# rest of the app is unaffected.
#
# There is no mock behind this one, unlike LEADBYTE_API_URL. An audit score is
# the one figure on this app a customer cannot check for themselves, so a
# seeded one would be worse than an empty screen.
#
# NOT NEXT_PUBLIC_ - this must never reach the browser bundle.
# e.g. https://xxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-east-1.on.aws
# ---------------------------------------------------------------------------
AEO_API_URL=

# (ADS_API_URL / ADS_API_KEY used to live here. They are gone, not forgotten:
# the backend team put POST /api/openai-ads on the leadbyte-api Lambda on
# 2026-09-15, so the ads client rides LEADBYTE_API_URL and nothing reads an
# ADS_* variable any more.)

# ---------------------------------------------------------------------------
# Firebase Web SDK — needed to obtain the idToken that /auth/google-signin
# exchanges for leadbyte-api's own JWTs.
#
# These are NEXT_PUBLIC_ on purpose: Firebase web API keys are public
# identifiers by design, not secrets. The Firebase *Admin* credentials
# (FIREBASE_PRIVATE_KEY etc.) live only in the Lambda and must never appear
# in this file.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=


# This app's own public origin (no trailing slash). Used to build the
# redirect_uri handed to Google's consent flow, which must be an absolute URL.
# Derived from the request Host header would be spoofable, so it is explicit.
#   dev:  http://localhost:3000
#   prod: https://<the new app's domain>
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Signs the sign-in cookies and encrypts customer secrets stored in cookies
# (lib/auth/signed-cookie.ts). REQUIRED in production: without it nobody can
# sign in. At least 32 random characters; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out once. Never NEXT_PUBLIC_.
# Local development falls back to a fixed value, so it may stay empty here.
# ---------------------------------------------------------------------------
SESSION_SECRET=
