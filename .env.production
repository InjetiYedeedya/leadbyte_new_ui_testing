# Read by `next build` (which `opennextjs-cloudflare build` runs) and copied
# into the browser code at build time.
#
# ONLY public values belong in this file. It is COMMITTED to Git.
# NEVER put LEADBYTE_API_KEY, SESSION_SECRET or any other secret here.
#
# NEXT_PUBLIC_FIREBASE_API_KEY is set in Cloudflare → Settings → Build →
# Variables and secrets, not here. All three are needed for sign-in
# (lib/firebase/client.ts).
#
# A value set in Cloudflare's Build settings OVERRIDES the same name here, so
# a wrong value there wins over the correct one below.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=leadbyte-82dd0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=leadbyte-82dd0

# This app's public origin, no trailing slash. Server-side, not a secret.
# Every OAuth return, Stripe success_url, admin invite and the background video
# are built from it (lib/api/config.ts), which falls back to localhost when it
# is missing. On 2026-09-30 the live Worker had no runtime APP_URL and every
# connection flow sent customers to http://localhost:3000.
#
# OpenNext bakes this file into the Worker as a FALLBACK: a runtime variable
# set in Cloudflare → Worker → Settings → Variables and secrets still wins.
# That is how the test Worker (workers.dev) should get its own value.
# lib/api/app-url.test.ts fails if this line goes missing or points at localhost.
APP_URL=https://app.leadbyte.ai
